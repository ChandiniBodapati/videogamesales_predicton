{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "1. Run Master MLOps Pipeline (--force)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/mlops_pipeline/vgsales_pipeline.py",
            "args": ["--force"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "2. Run Lab 9 Failure Injection Suite",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/mlops_pipeline/10_failure_injection.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "3. Run FastAPI Server (Uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "api.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--reload"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "4. Run Pytest Suite",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests", "-v"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "5. Run Continuous Drift Monitoring Trigger",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/mlops_pipeline/12_monitor_trigger.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "6. Run MLflow UI (Port 5000)",
            "type": "debugpy",
            "request": "launch",
            "module": "mlflow",
            "args": [
                "ui",
                "--backend-store-uri",
                "sqlite:///mlflow.db",
                "--port",
                "5000"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
